; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="YODS (4.7.1)"
run/main_scene="uid://cm8iwxas4pg7s"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/image="uid://dnnpjnesadxvi"
config/icon="res://icon.svg"

[autoload]

LevelManager="*res://00_globals/GlobalLevelManager.gd"
PlayerHud="*res://GUI/player_hud/player_hud.tscn"
PlayerManager="*res://00_globals/global_player_manager.gd"
SceneTransitions="*res://GUI/Scene_Transition/scene_transitions.tscn"
ReputationManager="*uid://dn5pv8gphrlrs"
SaveManager="*res://00_globals/global_save_manager.gd"
PauseMenu="*res://GUI/pause_menu/pause_menu.tscn"
InventoryMenu="*res://GUI/inventory_menu/inventory_menu.tscn"
GloabalChestManager="*res://00_globals/GloabalChestManager.gd"
PlayerStats="*uid://bfwhwk362xrtc"
ShopManager="*uid://cdla1gtlyfti1"
SkillTreeManager="*uid://3b32ji3bw4lm"
ShopLog="*uid://ddcrf4qkd1ff7"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
LightingManager="*res://00_globals/lighting_manager.gd"
TorchManager="*res://00_globals/torch_manager.gd"
DungeonRenown="*res://00_globals/dungeon_renown.gd"
DungeonPathfinder="*res://00_globals/dungeon_pathfinder.gd"
DungeonLifeManager="*res://00_globals/dungeon_life_manager.gd"
MapDiscoveryManager="*res://00_globals/map_discovery_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[global_group]

altar="Used for the skills stuff"

