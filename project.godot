;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="YODS (4.6)"
run/main_scene="uid://cm8iwxas4pg7s"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/image="uid://dnnpjnesadxvi"
config/icon="res://icon.svg"

[autoload]

LevelManager="*res://00_globals/GlobalLevelManager.gd"
PlayerHud="*res://GUI/player_hud/player_hud.tscn"
PlayerManager="*res://00_globals/global_player_manager.gd"
SceneTransitions="*res://GUI/Scene_Transition/scene_transitions.tscn"
SaveManager="*res://00_globals/global_save_manager.gd"
PauseMenu="*res://GUI/pause_menu/pause_menu.tscn"
InventoryMenu="*res://GUI/inventory_menu/inventory_menu.tscn"
GloabalChestManager="*res://00_globals/GloabalChestManager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"

